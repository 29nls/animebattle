{
  "name": "anime-vs-battle-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PRD, arsitektur, skema database, battle engine + case library, dan scaffolding Next.js dengan lint batas arsitektur untuk Anime VS Battle. Pipeline ingestion, auth, dan UI penuh belum dimulai.",
  "scripts": {
    "validate:schema": "node scripts/validate-schema.mjs",
    "typecheck": "tsc --noEmit",
    "validate:battle-cases": "node scripts/run-battle-cases.mjs",
    "check:battle-guards": "node scripts/mutate-battle-guards.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test:lint-rules": "node --test tools/eslint-plugin-architecture/__tests__/*.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
