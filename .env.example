# Salin berkas ini menjadi `.env.local` lalu isi nilainya.
# `.env*` di-`gitignore`; hanya `.env.example` yang ikut ter-commit, dan ia
# tidak boleh memuat kredensial nyata.

# ── Database ─────────────────────────────────────────────────────────────────
# URL Koneksi Supabase Database (PostgreSQL)
# Gunakan connection string untuk tipe 'Transaction pooler' (port 6543)
# Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:port/database"

# ── Rute admin (AC-26/§28 — jembatan sebelum Supabase Auth) ──────────────────
# Bearer token untuk POST /api/admin/ingestion/run, POST /api/admin/ingestion/import,
# dan GET /api/admin/metrics. Bila kosong, rute admin FAIL-CLOSED (503) untuk
# semua penelepon — tidak pernah bisa dipanggil publik.
ADMIN_INGESTION_SECRET=""

# ── Endpoint cron (dipakai .github/workflows/scheduled-ingest.yml) ───────────
# Bearer token untuk GET /api/cron/sync. Bila kosong, endpoint FAIL-CLOSED (503).
CRON_SECRET=""

# ── Pratinjau simulasi (NON-produksi saja) ───────────────────────────────────
# Set "1" untuk membuka jalur pratinjau /api/battle/simulate (body berisi `sides`
# langsung, untuk menguji request → engine tanpa database). Diabaikan bila
# NODE_ENV=production, sehingga dua gerbang harus terbuka bersamaan.
ALLOW_BATTLE_PREVIEW=""

# ── Metadata & SEO ───────────────────────────────────────────────────────────
# Base URL untuk metadata, Open Graph, robots.txt, dan sitemap.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=""
