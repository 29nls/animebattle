# Salin berkas ini menjadi `.env.local` lalu isi nilainya.
# `.env*` di-`gitignore`; hanya `.env.example` yang ikut ter-commit, dan ia
# tidak boleh memuat kredensial nyata.

# ── Database ─────────────────────────────────────────────────────────────────
# URL Koneksi Supabase Database (PostgreSQL)
# Gunakan connection string untuk tipe 'Transaction pooler' (port 6543)
# Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:port/database"

# ── Rute & panel admin (AC-26/§28 — jembatan sebelum Supabase Auth) ─────────
# Bearer token untuk seluruh /api/admin/* (ingestion/run, ingestion/import,
# ingestion/jobs, ingestion/jobs/:id/{errors,retry,cancel}, metrics) DAN token
# login halaman /admin. Halaman itu menyimpan cookie sesi bertanda tangan HMAC
# (12 jam, httpOnly, path=/admin) — rahasia tidak pernah dikirim ke browser.
# Bila kosong, rute admin FAIL-CLOSED (503) dan seluruh halaman /admin terkunci:
# tidak ada satu pun bagian panel yang bisa diakses publik.
# Nilai yang disarankan: `openssl rand -hex 32`.
ADMIN_INGESTION_SECRET=""

# ── Endpoint cron (dipakai .github/workflows/scheduled-ingest.yml) ───────────
# Bearer token untuk GET /api/cron/sync. Bila kosong, endpoint FAIL-CLOSED (503).
CRON_SECRET=""

# ── Pratinjau simulasi (NON-produksi saja) ───────────────────────────────────
# Set "1" untuk membuka jalur pratinjau /api/battle/simulate (body berisi `sides`
# langsung, untuk menguji request → engine tanpa database). Diabaikan bila
# NODE_ENV=production, sehingga dua gerbang harus terbuka bersamaan.
ALLOW_BATTLE_PREVIEW=""

# ── Dataset demo (NON-produksi) ──────────────────────────────────────────────
# Set "1" untuk memakai dataset demo sintetis (src/features/demo) ketika
# PostgreSQL belum dikonfigurasi, supaya halaman karakter/verse dan alur battle
# tetap dapat dijalankan dan diuji. Database selalu menang: begitu DATABASE_URL
# terisi, dataset demo tidak dipakai lagi. Halaman yang memakainya menampilkan
# penanda "data demo" karena data ini tidak dapat ditelusuri ke sumber (AC-09).
ALLOW_DEMO_DATA=""

# ── Metadata & SEO ───────────────────────────────────────────────────────────
# Base URL untuk metadata, Open Graph, robots.txt, dan sitemap.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=""
