# Salin berkas ini menjadi `.env.local` lalu isi nilainya.
# `.env*` di-`gitignore`; hanya `.env.example` yang ikut ter-commit, dan ia
# tidak boleh memuat kredensial nyata.

# ── Database ─────────────────────────────────────────────────────────────────
# URL Koneksi Supabase Database (PostgreSQL)
# Gunakan connection string untuk tipe 'Transaction pooler' (port 6543)
# Contoh: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@host:port/database"

# TLS: root CA Supabase sudah menjadi **bawaan** aplikasi
# (src/lib/db/supabase-ca.ts) dan dipakai otomatis untuk host
# `*.supabase.co/.com/.in` — jadi variabel ini **opsional**, hanya perlu bila
# DATABASE_URL menunjuk host non-Supabase atau Anda ingin menimpa CA bawaan.
# Isi PEM lengkap; nilai berkutip maupun satu-baris dengan `\n` literal diterima.
# Catatan: `sslrootcert` pada URL hanya dibaca bila berkasnya benar-benar ada di
# mesin yang menjalankan — path lokal (mis. C:/Users/...) tidak ada di Vercel
# dan kini diabaikan dengan aman, bukan menggagalkan koneksi.
DATABASE_CA_CERT=""

# ── Supabase Auth untuk panel & rute admin (AC-26/§28) ─────────────────────
# Login memakai email + password Supabase Auth; admin/owner wajib TOTP (aal2).
# Anon key memang publik (dipakai browser Supabase), tetapi JANGAN pernah
# menaruh service-role key di aplikasi atau di berkas ini. Peran dibaca dari
# tabel animebattle.user_roles di server.
# Bila URL/anon key kosong, rute /api/admin/* FAIL-CLOSED (503) dan panel
# /admin terkunci. Tidak ada fallback shared secret.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Salt opsional untuk hash IP pada audit_logs; kosong = hash tanpa salt.
IP_HASH_SALT=""

# ── Endpoint cron (dipakai .github/workflows/scheduled-ingest.yml) ───────────
# Bearer token untuk GET /api/cron/sync. Bila kosong, endpoint FAIL-CLOSED (503).
CRON_SECRET=""

# ── Pratinjau simulasi (NON-produksi saja) ───────────────────────────────────
# Set "1" untuk membuka jalur pratinjau /api/battle/simulate (body berisi `sides`
# langsung, untuk menguji request → engine tanpa database). Diabaikan bila
# NODE_ENV=production, sehingga dua gerbang harus terbuka bersamaan.
ALLOW_BATTLE_PREVIEW=""

# ── Dataset demo (NON-produksi) ──────────────────────────────────────────────
# Set "1" untuk memakai dataset demo sintetis (src/features/demo) ketika
# PostgreSQL belum dikonfigurasi, supaya halaman karakter/verse dan alur battle
# tetap dapat dijalankan dan diuji. Database selalu menang: begitu DATABASE_URL
# terisi, dataset demo tidak dipakai lagi. Halaman yang memakainya menampilkan
# penanda "data demo" karena data ini tidak dapat ditelusuri ke sumber (AC-09).
ALLOW_DEMO_DATA=""

# ── Metadata & SEO ───────────────────────────────────────────────────────────
# Base URL untuk metadata, Open Graph, robots.txt, dan sitemap.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=""
